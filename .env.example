# Local development (npm run db:local). On Supabase use the pooled URL here and the direct URL below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/inventory"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/inventory"

APP_URL="http://localhost:3000"

# Supabase Storage for product/damage photos. Leave empty to store files on local disk (./uploads).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="uploads"

# SMTP for password-reset emails. Leave empty to print reset links in the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Studio Rubina Inventory <no-reply@example.com>"
